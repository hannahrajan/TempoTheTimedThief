; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tempo the Timed Thief"
run/main_scene="uid://cs6yt84erlmwj"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://bjufvyg33nai3"

[autoload]

Hitstop="*uid://cvgi7v2mrp2fw"
TransitionScene="*uid://b8lrblnl6vkk1"
GameManager="*uid://ccxrm81jkpvgu"
LevelManager="*uid://dqin58mkmrylg"
SceneTransition="*uid://cw7kyg24euoyc"
AudioManager="*uid://mq8b6oh2egqf"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={
"Atto_hub_world": "res://assets/miscellaneous/dialogue/timelines/Atto_hub_world.dtl"
}
layout/style_directory={}
variables={
"$TIMELINE": {
"visited": 0
},
"@CHARACTER": {},
"SceneInfo": {
"scene": "DEFAULT"
}
}
layout/style_list=[]
layout/default_style="Default"

[display]

window/size/viewport_width=1200
window/size/viewport_height=900
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale=3.0
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://assets/audio/": "teal",
"res://assets/scenes/": "red",
"res://assets/scripts/": "orange",
"res://assets/sounds/": "teal",
"res://assets/sprites/": "blue"
}

